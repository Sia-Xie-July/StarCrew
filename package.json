{
  "name": "starcrew",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Stargazing trip planner agent: static web app plus a small Gemini API for access-code users",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --env-file=.env server/index.js",
    "serve": "python3 -m http.server 8000",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  }
}
